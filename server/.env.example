# AI API Keys Configuration
# Copy this file to .env and fill in your actual API keys

# Admin Account (set before first run)
ADMIN_PASSWORD=admin123

# DeepSeek Configuration (Default Provider)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Anthropic Configuration (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-opus-20240229

# MiniMax Configuration (Optional)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MODEL=M2-her

# Custom Provider Configuration (Optional)
CUSTOM_API_KEY=your_custom_api_key_here
CUSTOM_BASE_URL=https://api.example.com/v1
CUSTOM_MODEL=your-model

# Image Generation (文生图) - Evolink
IMAGE_API_KEY=your_image_api_key_here
IMAGE_BASE_URL=https://api.evolink.ai
IMAGE_MODEL=z-image-turbo

# Image-to-Image (图生图) - MiniMax
IMAGETOIMAGE_API_KEY=your_imagetoimage_api_key_here
IMAGETOIMAGE_BASE_URL=https://api.minimaxi.com
IMAGETOIMAGE_MODEL=image-01

# Default Provider
DEFAULT_PROVIDER=deepseek

# Log Level: error | warn | info | debug
LOG_LEVEL=info

# Admin Account
ADMIN_PASSWORD=admin123

# Image Bed URL (optional, for image hosting)
IMAGE_BED_URL=
